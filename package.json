{
	"private": true,
	"name": "obsidian-syncthing-integration",
	"version": "2.4.0",
	"description": "Syncthing integration for Obsidian",
	"main": "build/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm lint && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky install",
		"lint": "tsc -noEmit -skipLibCheck && tsc -p e2e && svelte-check --tsconfig ./tsconfig.json && eslint . --ext .ts,.svelte src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "wdio run ./e2e/wdio.conf.mts",
		"release": "semantic-release",
		"browsers": "pnpx update-browserslist-db@latest"
	},
	"keywords": [],
	"author": "LBF38",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/merge": "^6.12.3",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@commitlint/config-conventional": "^18.6.3",
		"@js-random/date": "^0.3.5",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/exec": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@total-typescript/ts-reset": "^0.6.1",
		"@tsconfig/svelte": "^5.0.8",
		"@types/marked": "^5.0.2",
		"@types/mocha": "10.0.10",
		"@types/node": "^22.20.5",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"@vitest/coverage-v8": "^4.1.12",
		"@wdio/cli": "9.32.0",
		"@wdio/globals": "9.31.3",
		"@wdio/local-runner": "9.32.0",
		"@wdio/mocha-framework": "9.32.0",
		"builtin-modules": "3.3.0",
		"child_process": "^1.0.2",
		"codemirror": "^6.0.2",
		"commitlint": "^18.6.1",
		"css-minify": "^2.1.0",
		"esbuild": "0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^8.57.1",
		"eslint-plugin-svelte": "^2.46.1",
		"fs": "0.0.1-security",
		"happy-dom": "^21.0.4",
		"husky": "^8.0.3",
		"lorem-ipsum": "^2.0.10",
		"marked": "^11.2.0",
		"mocha": "10.8.2",
		"obsidian": "^1.14.4",
		"obsidian-launcher": "3.4.0",
		"sass": "^1.107.1",
		"semantic-release": "^22.0.12",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tslib": "2.9.1",
		"tsx": "4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"wdio-obsidian-reporter": "3.4.0",
		"wdio-obsidian-service": "3.4.0",
		"webdriverio": "9.32.0"
	},
	"dependencies": {
		"style-mod": "^4.1.4"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/LBF38/obsidian-syncthing-integration.git"
	}
}
